# Reticle backend configuration.
#
# Copy to `.env` and fill in. Everything is prefixed RETICLE_, and every value
# shown here except the secret key and the database URL is the built-in default
# — so a minimal .env is those two lines.

# ---------------------------------------------------------------------------
# Required. No default exists on purpose: a shipped fallback would be the same
# on every installation, and this value is the pepper for session-token hashes.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RETICLE_SECRET_KEY=

# Where this file lives. Unset means `.env` in the working directory; a service
# manager usually wants an absolute path such as /etc/reticle/reticle.env.
# Set it to empty to ignore any file and use the process environment only.
# RETICLE_ENV_FILE=

# Required, and PostgreSQL only. There is no default: a working one would let a
# misconfigured server start against a database nobody meant to use and serve an
# empty library. One database per facility; deploy/provision-facility.sh writes
# this line for you.
RETICLE_DATABASE_URL=postgresql+psycopg://reticle_zmb:password@localhost/reticle_zmb

# Storage. The media root must NOT sit inside anything a web server serves,
# and it must be covered by .gitignore — uploads are ZMB's own photographs.
RETICLE_MEDIA_ROOT=./media

# Where the files themselves go. "local" writes under RETICLE_MEDIA_ROOT above;
# "s3" writes to object storage and serves each file as a short-lived signed
# URL after the same permission check.
#
# Switching to s3 needs one thing outside this file: the storage origin has to
# be named in the facility's Content-Security-Policy, because a media request
# then answers with a redirect off this origin and the browser judges the final
# URL against that policy. Without it every image and video is blocked, with
# nothing in any server log to say so. See docs/DEPLOYMENT.md, "Object storage".
RETICLE_STORAGE_BACKEND=local
RETICLE_S3_BUCKET=
RETICLE_S3_PREFIX=
# Set for MinIO or any non-AWS provider; empty means AWS.
RETICLE_S3_ENDPOINT_URL=
RETICLE_S3_REGION=

# How much the application says. DEBUG logs every SQL statement, which on this
# application means the full text of a guide on every save — useful for an
# afternoon, never in production.
RETICLE_LOG_LEVEL=INFO

# Who this instance belongs to. The interface reads these from /api/config at
# runtime, which is why one build of the frontend serves every facility.
# deploy/provision-facility.sh writes all three.
RETICLE_ORGANISATION_NAME=Center for Microscopy and Image Analysis
RETICLE_ORGANISATION_SHORT_NAME=ZMB
RETICLE_ORGANISATION_URL=

# What the front page's banner shows under and behind the name. Both optional:
# with no tagline the banner shows the name alone rather than an empty line,
# and with no picture it falls back to the drawn cover the section tiles use.
# The hero is the id of an already-uploaded image — upload one through the app,
# then take the id out of its /api/media/... address.
RETICLE_ORGANISATION_TAGLINE=
RETICLE_ORGANISATION_HERO_MEDIA_ID=

# Cookies. Set RETICLE_COOKIE_SECURE=false only for local http development;
# with it true (the default) the browser will not send the session over http.
# There is no cookie-domain setting: the session is scoped to the exact host
# that served it, so one facility's cookie is never sent to another's subdomain.
RETICLE_COOKIE_SECURE=true
RETICLE_SESSION_LIFETIME_HOURS=12

# Browser origins allowed to call the API with credentials. Comma separated.
RETICLE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login throttling. The two counters are independent: one guards a single
# account against a slow guess, the other guards against one host spraying many
# accounts.
RETICLE_LOGIN_MAX_ATTEMPTS_PER_EMAIL_AND_IP=5
RETICLE_LOGIN_MAX_ATTEMPTS_PER_EMAIL=50
RETICLE_LOGIN_MAX_ATTEMPTS_PER_IP=20
RETICLE_LOGIN_ATTEMPT_WINDOW_MINUTES=15

# Enable ONLY behind a reverse proxy that overwrites X-Forwarded-For. Without
# such a proxy this lets any client choose its own throttle bucket.
#
# Leave it false on the multi-facility deployment. There, uvicorn is started
# with --proxy-headers --forwarded-allow-ips 127.0.0.1, so it has already
# replaced the peer address with the real client's before a request reaches the
# application. Turning this on as well switches attribution to the LEFTMOST
# entry of the header, which is the one a client controls the moment any proxy
# in front appends instead of overwriting.
RETICLE_TRUST_FORWARDED_FOR=false

# Ceilings on everything that is not a login, per process and per minute. Set
# where a person cannot reach them and a runaway script can: an author saving
# every few seconds, a reader opening thirty guides and an importer pushing a
# corpus all have to pass untouched, because a limit that blocks real work gets
# switched off.
RETICLE_RATE_LIMIT_ENABLED=true
RETICLE_RATE_LIMIT_READS_PER_MINUTE=600
RETICLE_RATE_LIMIT_WRITES_PER_MINUTE=240
RETICLE_RATE_LIMIT_UPLOADS_PER_MINUTE=60

# Uploads. The pixel cap is separate from the per-side one on purpose: 10000 x
# 10000 satisfies "at most 10000 a side" and is 100 megapixels, which costs
# several hundred megabytes the moment anything decodes it.
RETICLE_MAX_UPLOAD_BYTES=20971520
RETICLE_MAX_IMAGE_DIMENSION=10000
RETICLE_MAX_IMAGE_PIXELS=40000000
RETICLE_MAX_MEDIA_PER_STEP=4

# Video gets its own, larger cap: a fifteen-second clip of a stage moving is an
# order of magnitude bigger than any photograph, and holding it to the image
# limit would reject exactly the files the video slot exists to accept.
RETICLE_MAX_VIDEO_BYTES=209715200

# Request bodies, excluding multipart uploads, which media streams separately.
RETICLE_MAX_REQUEST_BYTES=2097152

# Serves /docs, /redoc and /openapi.json. Leave false on anything deployed:
# they publish the whole route inventory and every field name unauthenticated.
RETICLE_DEBUG=false

# Passwords. Argon2id parameters follow the RFC 9106 second recommended
# profile; lower them only if the host genuinely cannot spare 64 MiB per login.
RETICLE_MIN_PASSWORD_LENGTH=12
RETICLE_ARGON2_TIME_COST=3
RETICLE_ARGON2_MEMORY_COST_KIB=65536
RETICLE_ARGON2_PARALLELISM=4

# First-run bootstrap, read by `python -m app.seed`. Seeding refuses to invent a
# password, so this must be set for the very first seed; unset it afterwards.
RETICLE_ADMIN_EMAIL=admin@zmb.uzh.ch
RETICLE_ADMIN_PASSWORD=
