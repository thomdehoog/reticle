# Reticle backend configuration.
#
# Copy to `.env` and fill in. Everything is prefixed RETICLE_ and every value
# shown here except the secrets is the built-in default, so a minimal .env only
# needs RETICLE_SECRET_KEY.

# ---------------------------------------------------------------------------
# Required. No default exists on purpose: a shipped fallback would be the same
# on every installation, and this value is the pepper for session-token hashes
# and the key that signs the login throttle's device cookies.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RETICLE_SECRET_KEY=

# Where this file lives. Unset means `.env` in the working directory; a service
# manager usually wants an absolute path such as /etc/reticle/reticle.env.
# Set it to empty to ignore any file and use the process environment only.
# RETICLE_ENV_FILE=

# ---------------------------------------------------------------------------
# Storage.
#
# The schema is created and upgraded by `python -m app.migrate`, which reads
# this URL. The server refuses to start until that has been run.
#
# SQLite is opened in write-ahead (WAL) mode, so next to the database file you
# will see `reticle.db-wal` and `reticle.db-shm`. They are part of the database:
# back up with `sqlite3 reticle.db ".backup copy.db"`, never by copying the one
# file while the server runs. Use an absolute path in production — note the
# four slashes: sqlite:////opt/reticle/shared/reticle.db
RETICLE_DATABASE_URL=sqlite:///./reticle.db

# The media root must NOT sit inside anything a web server serves, and it must
# be covered by .gitignore — uploads are ZMB's own photographs and videos.
RETICLE_MEDIA_ROOT=./media

# ---------------------------------------------------------------------------
# Cookies. Set RETICLE_COOKIE_SECURE=false only for local http development;
# with it true (the default) the browser will not send the session over http,
# and API responses carry Strict-Transport-Security.
RETICLE_COOKIE_SECURE=true
RETICLE_COOKIE_DOMAIN=
RETICLE_SESSION_LIFETIME_HOURS=12

# Browser origins allowed to call the API with credentials. Comma separated.
# Only needed when the frontend is served from a different origin than the API
# (the Vite dev server); behind one reverse proxy they share an origin. A `*`
# here is refused at start-up.
RETICLE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Reverse proxy.
#
# The addresses (or CIDR blocks) of the proxies in front of Reticle, comma
# separated. X-Forwarded-For is believed only on connections from one of these,
# and is read from the right so that a proxy which appends to the header
# (nginx's default) is as safe as one which overwrites it.
#
# In Docker behind a Caddy (or nginx) container the proxy's address is whatever
# the compose network hands out, so name the network's range, for example
#   RETICLE_TRUSTED_PROXIES=172.16.0.0/12
# or, better, give the compose network a fixed subnet and list exactly that.
#
# Start uvicorn with --no-proxy-headers so that this list is the only thing
# deciding whose X-Forwarded-For is believed. Left to its defaults uvicorn runs
# a second, independent copy of this logic that trusts the header from
# 127.0.0.1 (or from FORWARDED_ALLOW_IPS) before Reticle ever sees the request;
# that is harmless with a proxy on the same host, but it means any local
# process can claim any address, and it is one more thing to keep in step.
#
# Leave empty when nothing sits in front.
#
# Getting this wrong is not a security hole but it is an outage: every user
# then appears to come from the proxy, and twenty mistyped passwords anywhere in
# the building throttle logins for everyone. Reticle logs a warning when it
# sees the header arrive from an unlisted local address.
RETICLE_TRUSTED_PROXIES=

# Removed. RETICLE_TRUST_FORWARDED_FOR=true used to mean "believe the header
# from anybody"; Reticle now refuses to start if it is set without
# RETICLE_TRUSTED_PROXIES. Delete the line.

# ---------------------------------------------------------------------------
# Login throttling, per 15-minute window.
#
#   ..._PER_EMAIL_AND_IP  wrong guesses at one account from one source — or
#                         from one browser that has signed in to it before
#   ..._PER_IP            wrong guesses from one source across all accounts
#                         (password spraying); an IPv6 source is its whole /64
#   ..._PER_EMAIL         wrong guesses at one account from all sources together
#
# A browser that has signed in to an account before (it carries a signed
# `reticle_device` cookie) is not turned away by the per-source limit or by
# other people's guesses at the account, so nobody can lock a colleague out,
# and the noise of a shared address does not shut out its regulars. Such a
# browser gets the same ..._PER_EMAIL_AND_IP allowance for itself, and all of
# an account's known browsers together are held to ..._PER_EMAIL. The cookie
# lasts 180 days and is void once the account's password is changed or reset
# or the account is deactivated.
RETICLE_LOGIN_MAX_ATTEMPTS_PER_EMAIL_AND_IP=5
RETICLE_LOGIN_MAX_ATTEMPTS_PER_IP=20
RETICLE_LOGIN_MAX_ATTEMPTS_PER_EMAIL=50
RETICLE_LOGIN_ATTEMPT_WINDOW_MINUTES=15

# ---------------------------------------------------------------------------
# Request and upload ceilings, in bytes.
#
# Every request except an upload: JSON bodies, including a whole guide.
RETICLE_MAX_REQUEST_BYTES=2097152
# One image. Images are decoded in full to validate them, so they are held in
# memory: allow about 200 MB per worker for the largest picture permitted below.
RETICLE_MAX_UPLOAD_BYTES=20971520
# One video (MP4 or WebM). Streamed to disk, never held in memory.
# The reverse proxy must allow a body this large on /api/media:
#   nginx:  client_max_body_size 210m;   (and proxy_request_buffering off;)
#   Caddy:  request_body { max_size 210MB }
RETICLE_MAX_VIDEO_BYTES=209715200
# Per side, and in total. The total is what protects memory: 10000 x 10000
# passes the per-side limit and is a hundred megapixels.
RETICLE_MAX_IMAGE_DIMENSION=10000
RETICLE_MAX_IMAGE_PIXELS=40000000
RETICLE_MAX_MEDIA_PER_STEP=3

# Total size of the stored uploads, in bytes, at which new uploads are refused
# with 413. 0 means no limit. It is the sum of the uploaded originals as
# recorded in the database; the display copies made of large images and the PDF
# cache are not counted, so set it comfortably below the size of the volume.
# For example, 50 GB:  RETICLE_MAX_MEDIA_STORE_BYTES=53687091200
RETICLE_MAX_MEDIA_STORE_BYTES=0

# Where the rendered PDF of each published guide version is kept, so that it is
# laid out once and then served as a file. Leave empty for `.pdf-cache` inside
# RETICLE_MEDIA_ROOT, which is writable wherever uploads work. The directory
# must be writable by the server (in the container: somewhere under /data); if
# it is not, exports still work and are simply rendered every time. Nothing in
# it needs backing up — exclude it from backups if you like — and it can be
# deleted at any moment.
RETICLE_PDF_CACHE_DIR=

# ---------------------------------------------------------------------------
# Passwords. Argon2id parameters follow the RFC 9106 second recommended
# profile; lower them only if the host genuinely cannot spare 64 MiB per login.
# Raising them later upgrades each account's hash at its next sign-in.
RETICLE_MIN_PASSWORD_LENGTH=12
RETICLE_ARGON2_TIME_COST=3
RETICLE_ARGON2_MEMORY_COST_KIB=65536
RETICLE_ARGON2_PARALLELISM=4

# ---------------------------------------------------------------------------
# Development only. Serves /docs, /redoc and /openapi.json — without
# authentication, which is why it is off unless you ask.
RETICLE_DEBUG=false

# ---------------------------------------------------------------------------
# First-run bootstrap, read by `python -m app.seed`. Seeding refuses to invent a
# password, so this must be set for the very first seed; unset it afterwards.
RETICLE_ADMIN_EMAIL=admin@zmb.uzh.ch
RETICLE_ADMIN_PASSWORD=

# Only for `python -m app.seed --demo`. When set, demo mode also creates
# demo.author@<domain> and demo.viewer@<domain> with this password, the domain
# being the one in RETICLE_ADMIN_EMAIL. Leave empty to get the demo content
# without the accounts. Never set this on a production instance.
RETICLE_DEMO_PASSWORD=
